<!-- PROJECTS -->
<section id="projects">
  <div class="section-tag">Projects</div>
  <h2 class="section-title">Built from scratch,<br>with purpose.</h2>
  <div class="projects-grid">
    <div class="project-card">
      <div class="project-num">01</div>
      <div class="project-type">// Web Platform</div>
      <h3 class="project-title">Career Guidance Web Platform</h3>
      <p class="project-desc">A structured web platform providing clear information on entrance exams and academic pathways. Features categorised modules for intuitive content discoverability and seamless user navigation — designed to reduce decision fatigue for students.</p>
      <div class="project-stack">
        <span>HTML5</span>
        <span>CSS3</span>
        <span>JavaScript</span>
        <span>Responsive Design</span>
      </div>
    </div>

    <div class="project-card">
      <div class="project-num">02</div>
      <div class="project-type">// IoT + Hardware</div>
      <h3 class="project-title">IoT Sign Language Glove</h3>
      <p class="project-desc">A hardware-software prototype using flex sensors and an MPU6050 IMU to detect, classify, and convert hand gestures to text in real time via a connected mobile application — improving accessibility for speech- and hearing-impaired users.</p>
      <div class="project-stack">
        <span>Arduino</span>
        <span>Flex Sensors</span>
        <span>MPU6050</span>
        <span>Mobile App</span>
        <span>Signal Processing</span>
      </div>
    </div>

    <div class="project-card">
      <div class="project-num">03</div>
      <div class="project-type">// Backend API</div>
      <h3 class="project-title">Task Management System</h3>
      <p class="project-desc">A full-featured task and project management API built with Spring Boot. Includes secure JWT authentication, role-based access, workflow state machines, media uploads via Cloudinary, and a normalised MySQL schema.</p>
      <div class="project-stack">
        <span>Spring Boot</span>
        <span>MySQL</span>
        <span>JWT</span>
        <span>RBAC</span>
        <span>Cloudinary</span>
        <span>Postman</span>
      </div>
    </div>

    <div class="project-card" style="background:var(--accent);border-color:var(--accent)">
      <div class="project-num" style="color:rgba(255,255,255,0.08)">→</div>
