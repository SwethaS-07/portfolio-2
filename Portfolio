<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Swetha S — Java Full Stack Developer</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Mono:wght@400;500&family=Syne:wght@400;600;700;800&display=swap" rel="stylesheet"/>
<style>
  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
  :root{
    --ink:#0d0d0d;
    --paper:#f5f2eb;
    --cream:#eee9dc;
    --accent:#1a3a2a;
    --accent2:#c8522a;
    --accent3:#3a5c8a;
    --muted:#6b6560;
    --border:#d4cfc4;
    --card:#faf8f3;
    --mono:'DM Mono',monospace;
    --display:'DM Serif Display',serif;
    --sans:'Syne',sans-serif;
  }
  html{scroll-behavior:smooth}
  body{
    background:var(--paper);
    color:var(--ink);
    font-family:var(--sans);
    font-size:16px;
    line-height:1.6;
    overflow-x:hidden;
  }

  /* NAV */
  nav{
    position:fixed;top:0;left:0;right:0;z-index:100;
    display:flex;align-items:center;justify-content:space-between;
    padding:1rem 3rem;
    background:rgba(245,242,235,0.9);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--border);
  }
  .nav-logo{font-family:var(--mono);font-size:0.85rem;letter-spacing:0.05em;color:var(--muted)}
  .nav-links{display:flex;gap:2rem}
  .nav-links a{font-size:0.8rem;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;text-decoration:none;color:var(--muted);transition:color 0.2s}
  .nav-links a:hover{color:var(--accent)}

  /* HERO */
  .hero{
    min-height:100vh;
    display:grid;
    grid-template-columns:1fr 1fr;
    padding-top:80px;
    position:relative;
    overflow:hidden;
  }
  .hero-left{
    display:flex;flex-direction:column;justify-content:center;
    padding:5rem 3rem 5rem 5rem;
    position:relative;z-index:2;
  }
  .hero-tag{
    font-family:var(--mono);font-size:0.75rem;letter-spacing:0.2em;
    color:var(--accent2);text-transform:uppercase;
    margin-bottom:1.5rem;
    display:flex;align-items:center;gap:0.75rem;
  }
  .hero-tag::before{content:'';width:2rem;height:1px;background:var(--accent2)}
  .hero-name{
    font-family:var(--display);font-size:clamp(3.5rem,6vw,6rem);
    line-height:1.05;
    margin-bottom:0.5rem;
  }
  .hero-name em{font-style:italic;color:var(--accent)}
  .hero-title{
    font-family:var(--display);font-size:clamp(1.8rem,3vw,2.8rem);
    font-style:italic;color:var(--muted);
    line-height:1.2;margin-bottom:2rem;
  }
  .hero-desc{
    font-size:1rem;color:var(--muted);max-width:400px;
    line-height:1.8;margin-bottom:3rem;
  }
  .hero-cta{display:flex;gap:1rem;flex-wrap:wrap}
  .btn{
    display:inline-flex;align-items:center;gap:0.5rem;
    padding:0.75rem 1.75rem;
    font-family:var(--sans);font-size:0.8rem;font-weight:700;
    letter-spacing:0.1em;text-transform:uppercase;
    text-decoration:none;border:none;cursor:pointer;
    transition:all 0.25s;
  }
  .btn-primary{background:var(--accent);color:#fff}
  .btn-primary:hover{background:var(--accent2);transform:translateY(-2px)}
  .btn-outline{background:transparent;color:var(--ink);border:1.5px solid var(--border)}
  .btn-outline:hover{border-color:var(--ink);transform:translateY(-2px)}

  .hero-right{
    display:flex;align-items:center;justify-content:center;
    position:relative;
    padding:5rem 4rem 5rem 2rem;
  }
  .hero-graphic{
    position:relative;width:100%;max-width:420px;
  }
  .hero-box{
    background:var(--card);border:1px solid var(--border);
    padding:2.5rem;position:relative;
  }
  .hero-box::before{
    content:'';position:absolute;top:-8px;left:-8px;right:8px;bottom:8px;
    border:1px solid var(--accent);z-index:-1;
  }
  .stat-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;margin-bottom:2rem}
  .stat{border-left:3px solid var(--accent2);padding-left:1rem}
  .stat-num{font-family:var(--display);font-size:2.5rem;line-height:1;color:var(--accent)}
  .stat-label{font-size:0.75rem;color:var(--muted);font-weight:600;letter-spacing:0.08em;text-transform:uppercase}
  .skill-chips{display:flex;flex-wrap:wrap;gap:0.5rem}
  .chip{
    font-family:var(--mono);font-size:0.7rem;
    padding:0.3rem 0.75rem;
    background:var(--cream);border:1px solid var(--border);
    color:var(--muted);letter-spacing:0.05em;
  }
  .chip.active{background:var(--accent);color:#fff;border-color:var(--accent)}

  /* BG DECORATION */
  .bg-num{
    position:absolute;font-family:var(--display);
    font-size:20rem;color:rgba(26,58,42,0.04);
    line-height:1;z-index:0;pointer-events:none;
    right:-2rem;bottom:-2rem;
  }

  /* SECTION COMMON */
  section{padding:6rem 5rem}
  .section-tag{
    font-family:var(--mono);font-size:0.75rem;letter-spacing:0.2em;
    text-transform:uppercase;color:var(--accent2);
    margin-bottom:0.75rem;
    display:flex;align-items:center;gap:0.75rem;
  }
  .section-tag::before{content:'';width:2rem;height:1px;background:var(--accent2)}
  .section-title{
    font-family:var(--display);font-size:clamp(2rem,4vw,3.5rem);
    line-height:1.1;margin-bottom:3rem;
  }

  /* ABOUT / SKILLS */
  .about-grid{display:grid;grid-template-columns:1.2fr 1fr;gap:4rem;align-items:start}
  .about-text p{font-size:1.05rem;color:var(--muted);line-height:1.9;margin-bottom:1.25rem}
  .about-text p strong{color:var(--ink);font-weight:700}

 
  .skill-category{margin-bottom:2rem}
  .skill-cat-label{
    font-family:var(--mono);font-size:0.7rem;letter-spacing:0.15em;
    text-transform:uppercase;color:var(--accent3);
    margin-bottom:0.75rem;
  }
  .skill-pills{display:flex;flex-wrap:wrap;gap:0.5rem}
  .skill-pill{
    font-family:var(--mono);font-size:0.75rem;
    padding:0.35rem 0.9rem;
    border:1px solid var(--border);
    color:var(--ink);background:var(--card);
    transition:all 0.2s;cursor:default;
  }
  .skill-pill:hover{background:var(--accent);color:#fff;border-color:var(--accent);transform:translateY(-2px)}

  /* EXPERIENCE */
  .exp-section{background:var(--cream);padding:6rem 5rem}
  .exp-card{
    background:var(--card);border:1px solid var(--border);
    padding:2.5rem;position:relative;
    max-width:900px;
  }
  .exp-card::after{
    content:'';position:absolute;bottom:-6px;right:-6px;
    width:60px;height:60px;
    border-bottom:3px solid var(--accent2);border-right:3px solid var(--accent2);
  }
  .exp-header{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:1.5rem;flex-wrap:wrap;gap:1rem}
  .exp-role{font-family:var(--display);font-size:1.6rem;line-height:1.2}
  .exp-meta{text-align:right}
  .exp-period{font-family:var(--mono);font-size:0.75rem;color:var(--accent2);letter-spacing:0.1em}
  .exp-tech{display:flex;gap:0.5rem;flex-wrap:wrap;margin-top:0.5rem;justify-content:flex-end}
  .exp-tech span{
    font-family:var(--mono);font-size:0.65rem;padding:0.2rem 0.6rem;
    background:var(--accent);color:#fff;letter-spacing:0.05em;
  }
  .exp-bullets{list-style:none;margin-top:1rem}
  .exp-bullets li{
    font-size:0.95rem;color:var(--muted);padding:0.5rem 0;
    border-bottom:1px solid var(--border);
    display:flex;align-items:flex-start;gap:0.75rem;
    line-height:1.7;
  }
  .exp-bullets li::before{content:'→';color:var(--accent2);font-family:var(--mono);flex-shrink:0;margin-top:0.1rem}
  .exp-link{
    display:inline-flex;align-items:center;gap:0.5rem;
    margin-top:1.5rem;
    font-family:var(--mono);font-size:0.75rem;letter-spacing:0.1em;
    text-decoration:none;color:var(--accent3);
    text-transform:uppercase;
    border-bottom:1px solid var(--accent3);
    padding-bottom:2px;
    transition:all 0.2s;
  }
  .exp-link:hover{color:var(--accent2);border-color:var(--accent2)}

  /* PROJECTS */
  .projects-grid{display:grid;grid-template-columns:1fr 1fr;gap:2rem}
  .project-card{
    background:var(--card);border:1px solid var(--border);
    padding:2rem;position:relative;overflow:hidden;
    transition:transform 0.3s,box-shadow 0.3s;
  }
  .project-card:hover{transform:translateY(-4px);box-shadow:0 12px 40px rgba(0,0,0,0.08)}
  .project-num{
    font-family:var(--display);font-size:5rem;
    color:rgba(26,58,42,0.06);
    position:absolute;top:-0.5rem;right:1rem;
    line-height:1;pointer-events:none;
  }
  .project-type{
    font-family:var(--mono);font-size:0.7rem;letter-spacing:0.15em;
    text-transform:uppercase;color:var(--accent2);
    margin-bottom:0.75rem;
  }
  .project-title{font-family:var(--display);font-size:1.4rem;margin-bottom:1rem;line-height:1.25}
  .project-desc{font-size:0.9rem;color:var(--muted);line-height:1.8;margin-bottom:1.5rem}
  .project-stack{display:flex;flex-wrap:wrap;gap:0.4rem}
  .project-stack span{
    font-family:var(--mono);font-size:0.65rem;
    padding:0.2rem 0.6rem;border:1px solid var(--border);
    color:var(--muted);
  }

  /* ACHIEVEMENTS */
  .ach-section{background:var(--accent);color:#fff;padding:6rem 5rem}
  .ach-section .section-tag{color:rgba(255,255,255,0.5)}
  .ach-section .section-tag::before{background:rgba(255,255,255,0.5)}
  .ach-section .section-title{color:#fff}
  .ach-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem}
  .ach-card{
    border:1px solid rgba(255,255,255,0.15);
    padding:2rem;position:relative;
  }
  .ach-icon{font-size:1.5rem;margin-bottom:1rem;opacity:0.7}
  .ach-text{font-size:0.95rem;color:rgba(255,255,255,0.8);line-height:1.7}
  .ach-score{
    font-family:var(--display);font-size:2.5rem;
    color:#fff;margin-top:0.5rem;
  }

  /* CONTACT */
  .contact-section{padding:6rem 5rem}
  .contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:center}
  .contact-left .section-title{margin-bottom:1.5rem}
  .contact-left p{font-size:1.05rem;color:var(--muted);line-height:1.8;max-width:420px}
  .contact-links{display:flex;flex-direction:column;gap:1.25rem}
  .contact-link{
    display:flex;align-items:center;gap:1.25rem;
    text-decoration:none;color:var(--ink);
    padding:1rem 1.25rem;
    border:1px solid var(--border);background:var(--card);
    transition:all 0.25s;position:relative;
    overflow:hidden;
  }
  .contact-link::before{
    content:'';position:absolute;left:0;top:0;bottom:0;
    width:3px;background:var(--accent2);
  }
  .contact-link:hover{border-color:var(--accent);background:var(--cream);transform:translateX(4px)}
  .contact-link-icon{font-size:1.2rem;color:var(--accent2)}
  .contact-link-label{font-family:var(--mono);font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--muted)}
  .contact-link-value{font-size:0.9rem;font-weight:600;color:var(--ink);margin-top:0.1rem}

  /* FOOTER */
  footer{
    padding:2rem 5rem;
    border-top:1px solid var(--border);
    display:flex;justify-content:space-between;align-items:center;
    font-family:var(--mono);font-size:0.7rem;
    color:var(--muted);letter-spacing:0.08em;
  }

  /* ANIMATIONS */
  @keyframes fadeUp{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:translateY(0)}}
  .hero-tag{animation:fadeUp 0.6s ease 0.1s both}
  .hero-name{animation:fadeUp 0.6s ease 0.25s both}
  .hero-title{animation:fadeUp 0.6s ease 0.35s both}
  .hero-desc{animation:fadeUp 0.6s ease 0.45s both}
  .hero-cta{animation:fadeUp 0.6s ease 0.55s both}
  .hero-right{animation:fadeUp 0.8s ease 0.4s both}

  /* DIVIDER */
  .divider{border:none;border-top:1px solid var(--border);margin:0}

  /* RESPONSIVE */
  @media(max-width:900px){
    nav{padding:1rem 1.5rem}
    .hero{grid-template-columns:1fr;min-height:auto}
    .hero-left{padding:6rem 2rem 3rem}
    .hero-right{padding:2rem;display:none}
    section,.exp-section,.ach-section,.contact-section{padding:4rem 2rem}
    .about-grid,.contact-grid{grid-template-columns:1fr;gap:2.5rem}
    .projects-grid{grid-template-columns:1fr}
    .ach-grid{grid-template-columns:1fr}
    footer{flex-direction:column;gap:0.5rem;text-align:center;padding:1.5rem 2rem}
  }
</style>
</head>
