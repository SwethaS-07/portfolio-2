  <h2 class="section-title" style="color:#fff;font-family:var(--display);font-size:clamp(2rem,4vw,3.5rem);margin-bottom:2.5rem;color:var(--ink)">Where I've built<br>real things.</h2>
  <div class="exp-card">
    <div class="exp-header">
      <div>
        <div style="font-family:var(--mono);font-size:0.7rem;letter-spacing:0.15em;text-transform:uppercase;color:var(--accent2);margin-bottom:0.5rem">Internship</div>
        <div class="exp-role">Java Full Stack Developer<br><span style="font-style:italic;color:var(--muted)">Task Management System</span></div>
      </div>
      <div class="exp-meta">
        <div class="exp-period">Jan 2026 — Apr 2026</div>
